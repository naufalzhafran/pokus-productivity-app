{
  "$schema": "pokus-brand-tokens/1.0",
  "meta": {
    "brand": "Pokus",
    "version": "1.0.0",
    "updated": "2026-10-13",
    "notes": "Source of truth. tokens.css, tailwind.preset.js and ios/PokusTheme.swift are generated from / mirror this file. Edit here first."
  },
  "color": {
    "brand": {
      "night": "#14143C",
      "indigo": "#4B3BFF",
      "lime": "#D7FF3E",
      "paper": "#F1F0FF"
    },
    "indigo": {
      "50": "#F1F0FF", "100": "#E3E0FF", "200": "#C8C2FF", "300": "#A69CFF", "400": "#8B7DFF",
      "500": "#4B3BFF", "600": "#3A2AE6", "700": "#2E20B8", "800": "#231A8A", "900": "#1A155C", "950": "#14143C"
    },
    "lime": {
      "200": "#F0FFC2", "300": "#E7FF8A", "400": "#D7FF3E", "500": "#BDE620", "600": "#93B50F", "700": "#6B840A"
    },
    "neutral": {
      "0": "#FFFFFF", "50": "#F7F7FB", "100": "#EEEEF5", "200": "#DEDEEA", "300": "#C4C4D6", "400": "#9A9AB3",
      "500": "#6E6E8A", "600": "#50506B", "700": "#383852", "800": "#24243D", "900": "#191930", "950": "#0E0E22"
    }
  },
  "semantic": {
    "background":       { "light": "#F7F7FB", "dark": "#0E0E22", "use": "App/page background" },
    "surface":          { "light": "#FFFFFF", "dark": "#191930", "use": "Cards, sheets, list rows" },
    "surfaceRaised":    { "light": "#FFFFFF", "dark": "#24243D", "use": "Popovers, menus, modals" },
    "surfaceSunken":    { "light": "#EEEEF5", "dark": "#0A0A1A", "use": "Inputs, wells, segmented control track" },
    "border":           { "light": "#DEDEEA", "dark": "#383852", "use": "Dividers, card outlines" },
    "textPrimary":      { "light": "#14143C", "dark": "#F1F0FF", "use": "Body and headings" },
    "textSecondary":    { "light": "#50506B", "dark": "#9A9AB3", "use": "Metadata, helper text (AA on surface)" },
    "primary":          { "light": "#4B3BFF", "dark": "#8B7DFF", "use": "Primary buttons, links, selected state" },
    "primaryPressed":   { "light": "#3A2AE6", "dark": "#A69CFF", "use": "Pressed/hover state of primary" },
    "onPrimary":        { "light": "#FFFFFF", "dark": "#0E0E22", "use": "Text/icons on primary" },
    "accent":           { "light": "#D7FF3E", "dark": "#D7FF3E", "use": "Highlights, streaks, 'Pokus done' moments. FILL ONLY on light mode, never text." },
    "onAccent":         { "light": "#14143C", "dark": "#14143C", "use": "Text/icons on accent" },
    "focusRing":        { "light": "#4B3BFF", "dark": "#D7FF3E", "use": "Keyboard focus outline (2px, 2px offset)" },
    "sessionFocus":     { "light": "#4B3BFF", "dark": "#8B7DFF", "use": "Timer ring + chips while a Pokus is running" },
    "sessionBreak":     { "light": "#BDE620", "dark": "#D7FF3E", "use": "Timer ring + chips during a break (pair with night text)" },
    "sessionPaused":    { "light": "#9A9AB3", "dark": "#6E6E8A", "use": "Paused / idle timer" },
    "success":          { "light": "#1A7F45", "dark": "#4ADE80", "use": "Completed tasks, saved" },
    "warning":          { "light": "#A35F00", "dark": "#FFB224", "use": "Overdue soon, unsynced" },
    "danger":           { "light": "#D93036", "dark": "#FF6369", "use": "Destructive actions, errors" }
  },
  "typography": {
    "families": {
      "display": { "web": "'Unbounded', 'Space Grotesk', system-ui, sans-serif", "ios": "Unbounded (bundled) — fallback .rounded system", "use": "Wordmark, screen titles, timer digits, big numbers" },
      "text":    { "web": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif", "ios": "SF Pro (system font)", "use": "All UI and reading text" }
    },
    "scale": {
      "timer":     { "family": "display", "size": 72, "lineHeight": 72, "weight": 500, "tracking": -0.02, "numeric": "tabular" },
      "displayL":  { "family": "display", "size": 40, "lineHeight": 44, "weight": 700, "tracking": -0.02 },
      "displayM":  { "family": "display", "size": 28, "lineHeight": 34, "weight": 700, "tracking": -0.01 },
      "displayS":  { "family": "display", "size": 22, "lineHeight": 28, "weight": 600, "tracking": 0 },
      "title":     { "family": "text", "size": 20, "lineHeight": 28, "weight": 700, "tracking": -0.01 },
      "headline":  { "family": "text", "size": 17, "lineHeight": 24, "weight": 700, "tracking": 0 },
      "body":      { "family": "text", "size": 16, "lineHeight": 24, "weight": 500, "tracking": 0 },
      "bodySmall": { "family": "text", "size": 14, "lineHeight": 20, "weight": 500, "tracking": 0 },
      "label":     { "family": "text", "size": 13, "lineHeight": 18, "weight": 700, "tracking": 0.01 },
      "caption":   { "family": "text", "size": 12, "lineHeight": 16, "weight": 600, "tracking": 0.02 }
    },
    "units": "size/lineHeight in px (web) = pt (iOS). tracking in em."
  },
  "spacing": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 },
  "radius": { "xs": 6, "sm": 10, "md": 14, "lg": 20, "xl": 28, "full": 9999 },
  "shadow": {
    "sm": "0 1px 2px rgba(20,20,60,0.06), 0 1px 1px rgba(20,20,60,0.04)",
    "md": "0 4px 12px rgba(20,20,60,0.08), 0 1px 3px rgba(20,20,60,0.06)",
    "lg": "0 16px 40px rgba(20,20,60,0.14), 0 4px 10px rgba(20,20,60,0.06)",
    "darkModeNote": "In dark mode replace shadows with surfaceRaised + 1px border; shadows are invisible on #0E0E22."
  },
  "motion": {
    "duration": { "fast": 150, "base": 250, "slow": 400, "timerTick": 1000 },
    "easing": { "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)", "spring": "iOS: .spring(response: 0.35, dampingFraction: 0.8)" }
  },
  "layout": {
    "touchTargetMin": 44,
    "contentMaxWidth": 1200,
    "sidebarWidth": 264,
    "gutterMobile": 16,
    "gutterDesktop": 32
  }
}
